{
  "name": "@comandeer/eslint-config",
  "version": "0.18.0",
  "type": "module",
  "description": "Shareable ESLint configuration",
  "exports": {
    ".": {
      "import": "./dist/eslint-config.mjs"
    },
    "./formatting": {
      "import": "./dist/eslint-config-formatting.mjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "lint": "eslint \"{src,tests}/**/*.js\"",
    "build": "rlb",
    "test": "ava",
    "version": "npm test && npm run build && git add -f dist/",
    "postversion": "git rm -r --cached dist/ && git commit -m \"chore(dist): clean after release [ci skip]\" && git push origin && git push origin --tags",
    "prepare": "husky"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Comandeer/eslint-config.git"
  },
  "keywords": [
    "eslint",
    "eslintconfig"
  ],
  "author": "Comandeer",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/Comandeer/eslint-config/issues"
  },
  "homepage": "https://github.com/Comandeer/eslint-config#readme",
  "commitplease": {
    "nohook": true,
    "style": "angular",
    "types": [
      "feat",
      "fix",
      "docs",
      "style",
      "refactor",
      "perf",
      "test",
      "build",
      "ci",
      "chore",
      "revert"
    ],
    "scope": "\\S+.*"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  },
  "peerDependencies": {
    "eslint": ">=10.0.0"
  },
  "devDependencies": {
    "@comandeer/rollup-lib-bundler": "0.27.0",
    "ava": "6.4.1",
    "commitplease": "3.2.0",
    "cz-conventional-changelog": "3.3.0",
    "eslint": "10.0.0",
    "execa": "9.6.1",
    "husky": "9.1.7",
    "pathe": "2.0.3",
    "tempy": "3.2.0"
  },
  "dependencies": {
    "@stylistic/eslint-plugin": "5.8.0",
    "@typescript-eslint/eslint-plugin": "8.56.0",
    "@typescript-eslint/parser": "8.56.0",
    "eslint-plugin-ava": "16.0.0",
    "globals": "17.3.0"
  }
}
